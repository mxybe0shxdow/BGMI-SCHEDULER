rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // BGMI Squad Scheduler Rules
    // Multi-user collaborative app: squad members can view, add, update, and manage sessions
    
    match /users/{userId} {
      allow read, write: if true;
    }
    
    match /availability/{availId} {
      allow read, write: if true;
    }
    
    match /sessions/{sessionId} {
      allow read, write: if true;
    }
    
    match /activity_log/{logId} {
      allow read, write: if true;
    }
  }
}
